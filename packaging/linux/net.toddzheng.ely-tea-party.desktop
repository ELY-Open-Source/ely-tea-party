[Desktop Entry]
Type=Application
Name=Ely Tea Party
Comment=A terminal on GPUI and Ely
Exec=ely-tea-party %u
X-TerminalArgDir=--working-directory
Icon=net.toddzheng.ely-tea-party
Terminal=false
Categories=System;TerminalEmulator;
MimeType=x-scheme-handler/elyteaparty;
StartupWMClass=net.toddzheng.ely-tea-party
